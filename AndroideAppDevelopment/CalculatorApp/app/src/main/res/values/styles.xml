<resources>

    <!-- Base style: every grid cell fills its cell equally, keeping the grid responsive -->
    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Number">
        <item name="android:background">@drawable/bg_btn_number</item>
        <item name="android:textColor">@color/number_btn_text</item>
    </style>

    <style name="CalcButton.Number.Wide">
        <item name="android:background">@drawable/bg_btn_number_wide</item>
        <item name="android:textColor">@color/number_btn_text</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">28dp</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:background">@drawable/bg_btn_operator</item>
        <item name="android:textColor">@color/operator_btn_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButton.Function">
        <item name="android:background">@drawable/bg_btn_function</item>
        <item name="android:textColor">@color/function_btn_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Scrollable display area: shows the running expression + result -->
    <ScrollView
        android:id="@+id/displayScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonGrid"
        app:layout_constraintHeight_percent="0.30">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Small line showing the pending expression, e.g. "12 +" -->
            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/display_sub_text"
                android:textSize="20sp"
                android:maxLines="1"
                android:text="" />

            <!-- Main display: current input / result -->
            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:textColor="@color/display_text"
                android:textSize="48sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="start"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeMaxTextSize="48sp"
                android:text="@string/default_display"
                android:contentDescription="Calculator display" />
        </LinearLayout>
    </ScrollView>

    <!-- Button grid: 4 columns x 5 rows, evenly weighted so it's responsive -->
    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/displayScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButton.Function"
            android:layout_row="0"
            android:layout_column="0"
            android:text="@string/btn_clear"
            android:contentDescription="Clear" />

        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalcButton.Function"
            android:layout_row="0"
            android:layout_column="1"
            android:text="@string/btn_backspace"
            android:contentDescription="Backspace" />

        <View
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalcButton.Operator"
            android:layout_row="0"
            android:layout_column="3"
            android:text="@string/btn_divide"
            android:contentDescription="Divide" />

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" style="@style/CalcButton.Number" android:layout_row="1" android:layout_column="0" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton.Number" android:layout_row="1" android:layout_column="1" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton.Number" android:layout_row="1" android:layout_column="2" android:text="9" />
        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalcButton.Operator"
            android:layout_row="1"
            android:layout_column="3"
            android:text="@string/btn_multiply"
            android:contentDescription="Multiply" />

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" style="@style/CalcButton.Number" android:layout_row="2" android:layout_column="0" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton.Number" android:layout_row="2" android:layout_column="1" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton.Number" android:layout_row="2" android:layout_column="2" android:text="6" />
        <Button
            android:id="@+id/btnSubtract"
            style="@style/CalcButton.Operator"
            android:layout_row="2"
            android:layout_column="3"
            android:text="@string/btn_subtract"
            android:contentDescription="Subtract" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" style="@style/CalcButton.Number" android:layout_row="3" android:layout_column="0" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton.Number" android:layout_row="3" android:layout_column="1" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton.Number" android:layout_row="3" android:layout_column="2" android:text="3" />
        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButton.Operator"
            android:layout_row="3"
            android:layout_column="3"
            android:text="@string/btn_add"
            android:contentDescription="Add" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton.Number.Wide"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:text="0" />

        <Button
            android:id="@+id/btnDecimal"
            style="@style/CalcButton.Number"
            android:layout_row="4"
            android:layout_column="2"
            android:text="@string/btn_decimal" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButton.Operator"
            android:layout_row="4"
            android:layout_column="3"
            android:text="@string/btn_equals"
            android:contentDescription="Equals" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

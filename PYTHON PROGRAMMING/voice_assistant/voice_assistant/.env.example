# Copy this file to .env and fill in real values, OR export these as
# regular shell environment variables. Never commit a real .env file.

# --- Weather (get a free key at https://openweathermap.org/api) ---
OPENWEATHER_API_KEY=

# --- Email (use a TEST/DUMMY account, not your real one) ---
# For Gmail: enable 2FA, then generate an "App Password" at
# https://myaccount.google.com/apppasswords and use that here, NOT your
# normal Google account password.
SENDER_EMAIL=
SENDER_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
